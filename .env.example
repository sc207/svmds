# ── SVMDS backend — copy to .env for local dev; set the real values in Render ──

# 'production' toggles secure cookies, strict CSP, error masking and fail-fast checks
NODE_ENV=development

# Local listen port (Render injects its own PORT)
PORT=3000

# HS256 signing key for session JWTs. MUST be a strong 32+ char random string in prod.
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-secret-change-in-production

# The one Google address that is bootstrapped as `superadmin` on every boot (idempotent)
ADMIN_EMAIL=

# Display string (page titles)
APP_NAME=Shri Vihat Meldi Mata Mandir

# Google OAuth **Web** client id (Google Cloud Console → APIs & Services → Credentials).
# Used by the Google Sign-In button in public/login.html and as the ID-token
# audience the server verifies. No client *secret* is needed.
GOOGLE_CLIENT_ID=

# Turso (libsql) — leave BOTH blank for local dev (falls back to data/svmds.db)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Comma-separated CORS origin allowlist for production (e.g. https://svmds.onrender.com)
# Empty ⇒ all origins allowed (dev only)
ALLOWED_ORIGINS=

# Optional tunables
SESSION_DAYS=7
